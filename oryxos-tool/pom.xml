<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>com.oryxos</groupId>
        <artifactId>oryxos-parent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>oryxos-tool</artifactId>
    <name>oryxos-tool</name>
    <description>核心能力四（三合一模块）：内置 Tool、McpClientService、McpToolAdapter、ToolRegistry、Sandbox 接口 + WhitelistSandbox、NotifyChannelAdapter + WebhookNotifyAdapter</description>

    <dependencies>
        <dependency>
            <groupId>com.oryxos</groupId>
            <artifactId>oryxos-core</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
        <!-- 第 19 节 Notify：RestClient（WebhookNotifyAdapter 同步 HTTP 出站推送）；
             spring 全家桶成员，版本走 Boot BOM，非新第三方依赖 -->
        <dependency>
            <groupId>org.springframework</groupId>
            <artifactId>spring-web</artifactId>
        </dependency>
        <!-- 第 19 节 Notify：@Tool/@ToolParam 注解（NotifyTools 方法标记，20 节 AnnotatedToolAdapter
             扫描注册后生成 schema）；core 已依赖，此处显式化（18 节 R3 先例），版本走 Spring AI BOM -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-model</artifactId>
        </dependency>
        <!-- 第 20 节 Tool 体系：MCP 客户端 SDK（McpClientService/McpToolAdapter）。已在锁定依赖链内
             （spring-ai-client-chat 1.1.8 -> mcp-json-jackson2 0.18.3 -> mcp-core 0.18.3，
             mvn dependency:tree 实测），但 spring-ai-bom/parent 均不管理其版本，显式锁 0.18.3
             （mockwebserver 4.12.0 先例），enforcer dependencyConvergence 保持绿 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-core</artifactId>
            <version>0.18.3</version>
        </dependency>
        <!-- MCP SDK 的 JSON 映射实现（StdioClientTransport 需要 McpJsonMapper 实例）；
             同 mcp-core 0.18.3，锁定链内工件 -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-json-jackson2</artifactId>
            <version>0.18.3</version>
        </dependency>
        <!-- 第 20 节 Tool 体系：McpClientService 读 .oryxos/mcp_servers.yaml（SnakeYAML 解析）；
             版本走 Boot BOM，经 starter 传递已在链，显式化（18 节 R3 先例） -->
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- 第 19 节 harness 第一批：MockWebServer 本地回环假 webhook（课件明言不算外网依赖，
             仍是单测层）。Boot 3.5 BOM 已移除 okhttp3 版本管理，显式锁 4.12.0（与本地
             生态一致；okhttp 5.x 的 mockwebserver3 改了坐标与 API，不跟） -->
        <dependency>
            <groupId>com.squareup.okhttp3</groupId>
            <artifactId>mockwebserver</artifactId>
            <version>4.12.0</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
